# Tokens da API do Tiny ERP (v2 classica), um por CNPJ/conta Tiny.
# Tiny -> Configuracoes -> API, dentro de cada conta.
TINY_API_TOKEN_AMOSHOESGYN=
TINY_API_TOKEN_AMOSHOES=
TINY_API_TOKEN_INAMORATO=
TINY_API_TOKEN_28849110000141=

# --- Mercado Livre: um app OAuth por conta (criado em developers.mercadolivre.com.br) ---
# Client ID nao e segredo, mas o Client Secret sim.
ML_REDIRECT_URI=https://caixa-amo.vercel.app/oauth/ml-callback

ML_APP_ID_MELI_CONTA_1=
ML_CLIENT_SECRET_MELI_CONTA_1=

ML_APP_ID_MELI_CONTA_2=
ML_CLIENT_SECRET_MELI_CONTA_2=

ML_APP_ID_MELI_CONTA_3=
ML_CLIENT_SECRET_MELI_CONTA_3=

ML_APP_ID_MELI_CONTA_4=
ML_CLIENT_SECRET_MELI_CONTA_4=

# --- WhatsApp: escolher UM provider em config.yaml (alertas.whatsapp.provider) ---
# CallMeBot (gratuito) - uma chave POR NUMERO destinatario, ja que cada um
# ativa o bot individualmente (ver README). Nomeie a variavel com o numero
# exatamente como aparece em config.yaml > alertas.whatsapp.destinatarios.
CALLMEBOT_APIKEY_5511999999999=

# Z-API (pago, mais rapido de configurar, sem aprovacao da Meta)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Meta Cloud API (oficial, gratuito ate um volume mensal, mas exige
# aprovacao/numero comercial verificado)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE=

# --- Supabase (mesmo projeto do AmoApp - rohkbgywmskllgxufmyp) ---
# So alimenta o dashboard de margem, nao e usado pelo dedupe/checkpoint
# (que continua no SQLite local).
SUPABASE_URL=
# monitor.py escreve -> SERVICE ROLE key (ignora RLS)
SUPABASE_SERVICE_ROLE_KEY=
# dashboard.py so le -> chave anon (RLS permite SELECT nas tabelas novas)
SUPABASE_ANON_KEY=
